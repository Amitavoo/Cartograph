# ==============================================================================
# Cartograph Environment Variables
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Database & Storage)
# ------------------------------------------------------------------------------
# Public Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anonymous / Publishable Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your_supabase_publishable_key_here

# Direct PostgreSQL Connection String for Database Migrations and Pipeline Ingestion
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Service Role Key (Server-only, bypasses RLS for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJh...your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Clerk Authentication Configuration
# ------------------------------------------------------------------------------
# Public Clerk Publishable Key (found in Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Clerk Secret Key (Server-only)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Route Handlers & Fallbacks
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ------------------------------------------------------------------------------
# Google Gemini AI (Module Explanations & Repository Intelligence)
# ------------------------------------------------------------------------------
# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
# Alternative alias:
# GOOGLE_API_KEY=AIzaSy...your_gemini_api_key_here

# ------------------------------------------------------------------------------
# LangSmith Observability & Agent Evaluations
# ------------------------------------------------------------------------------
# Enable LangSmith tracing for LLM calls and evaluation runs
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...your_langsmith_api_key_here
LANGSMITH_PROJECT=cartograph

# ------------------------------------------------------------------------------
# Autonomous Agent & Pipeline Service
# ------------------------------------------------------------------------------
# Secret token for authenticating tool calls between the agent runner and API
AGENT_TOKEN_SECRET=your_agent_internal_token_secret_here

# Optional: GitHub Personal Access Token (for higher GitHub REST API rate limits)
# Not required for public repo tarball downloads, but recommended for frequent usage
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here
